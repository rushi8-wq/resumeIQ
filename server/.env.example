PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/resumeiq
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://127.0.0.1:5173
COOKIE_SAME_SITE=lax
AI_PROVIDER=groq
OPENAI_API_KEY=
JOB_API_KEY=

# Optional M3 embeddings; no external call without per-analysis consent.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
# MATCH_WEIGHTS_JSON={"requiredSkills":35,"experience":25,"semantic":20,"preferredSkills":10,"qualifications":10}

# M4: paste your key only into server/.env, never into chat/source.
GROQ_API_KEY=
GROQ_MODEL=auto
